<footer>
    <div class="container footer-content">
        <p>Designed & Built for <%= data.personalInfo.name %>
        </p>
        <p>
            <% 
              const fpRaw = data.personalInfo.phone.replace(/\D/g, ''); 
              const fp1 = fpRaw.substring(0, 4); 
              const fp2 = fpRaw.substring(4);
              const [feUser, feDomain] = data.personalInfo.email.split('@'); 
            %>
            📞 <a href="#" class="protected-phone" data-p1="<%= fp1 %>" data-p2="<%= fp2 %>" data-display="<%= data.personalInfo.phone %>" style="color: inherit; text-decoration: none;">
                  <span class="update-text">Loading...</span>
               </a> 
            | ✉️ <a href="#" class="protected-email" data-u="<%= feUser %>" data-d="<%= feDomain %>" style="color: inherit; text-decoration: none;">
                  <span class="update-text">Loading...</span>
               </a>
        </p>
    </div>
</footer>